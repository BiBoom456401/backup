@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <div class="sidebar d-flex flex-column">
        <div class="sidebar-header">
            <img src="/images/logo-student.png" alt="Logo" />
            <h4>Student Panel</h4>
            <div class="small">Sinh viên</div>
        </div>
        <nav class="nav flex-column mt-4">
            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-tachometer-alt me-2"></i> Dashboard</a>
            <a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="fas fa-user me-2"></i> Thông tin cá nhân</a>
            <a class="nav-link" asp-controller="Score" asp-action="Index"><i class="fas fa-chart-line me-2"></i> Điểm số</a>
            <a class="nav-link" asp-controller="Schedule" asp-action="Index"><i class="fas fa-calendar-alt me-2"></i> Thời khóa biểu</a>
        </nav>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-3 px-3">
            <button type="submit" class="btn btn-outline-danger w-100">
                <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
            </button>
        </form>
    </div>
    <div class="main-content" style="margin-left:240px; padding:2rem 2rem 0 2rem;">
        @RenderBody()
    </div>
    <footer class="border-top text-muted py-3 mt-4" style="margin-left:240px;">
        <div class="container text-center">
            &copy; 2025 - Student Manager - <a asp-controller="Home" asp-action="Privacy">Chính sách & bảo mật</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 