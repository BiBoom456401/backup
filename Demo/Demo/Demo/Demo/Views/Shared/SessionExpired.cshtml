@{
    ViewData["Title"] = "Phiên đăng nhập đã hết hạn";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-gradient-warning text-white text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-shield-alt fa-3x"></i>
                    </div>
                    <h3 class="mb-0">Phiên đăng nhập đã hết hạn</h3>
                    <p class="mb-0 mt-2 opacity-75">Single Session Management</p>
                </div>
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="alert alert-warning border-0">
                                    <i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>
                                    <strong>Phát hiện</strong>
                                    <p class="small mb-0">Đăng nhập từ thiết bị khác</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="alert alert-info border-0">
                                    <i class="fas fa-user-times fa-2x mb-2 d-block"></i>
                                    <strong>Hành động</strong>
                                    <p class="small mb-0">Tự động đăng xuất bảo mật</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="alert alert-success border-0">
                                    <i class="fas fa-lock fa-2x mb-2 d-block"></i>
                                    <strong>Bảo vệ</strong>
                                    <p class="small mb-0">Tài khoản được an toàn</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light border p-4 text-center">
                        <h5 class="text-dark mb-3">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            Tại sao điều này xảy ra?
                        </h5>
                        <p class="mb-3">
                            Hệ thống phát hiện tài khoản của bạn đang được đăng nhập từ một thiết bị hoặc trình duyệt khác. 
                            Để đảm bảo bảo mật, chúng tôi chỉ cho phép <strong>một phiên đăng nhập</strong> tại một thời điểm.
                        </p>
                        <div class="row text-start">
                            <div class="col-md-6">
                                <h6 class="text-success"><i class="fas fa-check me-2"></i>Lợi ích:</h6>
                                <ul class="list-unstyled ps-3">
                                    <li><i class="fas fa-shield-check text-success me-2"></i>Bảo vệ khỏi truy cập trái phép</li>
                                    <li><i class="fas fa-user-shield text-success me-2"></i>Ngăn chặn sử dụng tài khoản bất hợp pháp</li>
                                    <li><i class="fas fa-lock text-success me-2"></i>Tăng cường bảo mật dữ liệu</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-info"><i class="fas fa-lightbulb me-2"></i>Cách thức hoạt động:</h6>
                                <ul class="list-unstyled ps-3">
                                    <li><i class="fas fa-eye text-info me-2"></i>Theo dõi session theo thời gian thực</li>
                                    <li><i class="fas fa-sync text-info me-2"></i>Kiểm tra tính hợp lệ định kỳ</li>
                                    <li><i class="fas fa-sign-out-alt text-info me-2"></i>Tự động đăng xuất session cũ</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <div class="btn-group-vertical btn-group-lg" role="group">
                            <a href="/Identity/Account/Login" class="btn btn-primary btn-lg mb-2">
                                <i class="fas fa-sign-in-alt me-2"></i>
                                Đăng nhập lại ngay
                            </a>
                            <a href="/" class="btn btn-outline-secondary">
                                <i class="fas fa-home me-2"></i>
                                Về trang chủ
                            </a>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <small class="text-muted">
                            <i class="fas fa-clock me-1"></i>
                            Thời gian: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                        </small>
                    </div>
                </div>
                <div class="card-footer bg-light text-center border-0">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-md-start text-center">
                            <small class="text-muted">
                                <i class="fas fa-shield-alt text-success me-1"></i>
                                <strong>Tính năng Single Session Management</strong>
                            </small>
                        </div>
                        <div class="col-md-6 text-md-end text-center mt-2 mt-md-0">
                            <a href="/SessionTest" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-test-tube me-1"></i>
                                Kiểm tra tính năng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .card-header {
        border-bottom: none;
    }
    
    .text-warning {
        color: #f39c12 !important;
    }
    
    .bg-warning {
        background-color: #f39c12 !important;
    }
</style>
