@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Student Dashboard";
}
<div class="container-fluid">
    <h2 class="mb-4 fw-bold text-info"><i class="fas fa-user-graduate me-2"></i>Quản lý học tập</h2>
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-chart-line fa-2x text-danger"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">--</h5>
                        <small class="text-muted">Điểm TB cá nhân</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-book-open fa-2x text-success"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">--</h5>
                        <small class="text-muted">Tín chỉ đã học</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-3">
                        <i class="fas fa-hourglass-half fa-2x text-warning"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">--</h5>
                        <small class="text-muted">Tín chỉ còn lại</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-8 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold"><i class="fas fa-calendar-alt me-2"></i>Lịch học tuần này</div>
                <div class="card-body p-0 text-center text-muted">
                    <span>[Lịch học sẽ hiển thị ở đây]</span>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold"><i class="fas fa-user me-2"></i>Thông tin cá nhân</div>
                <div class="card-body text-center text-muted">
                    <span>[Thông tin cá nhân sẽ hiển thị ở đây]</span>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-8 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold"><i class="fas fa-list-alt me-2"></i>Điểm các môn gần nhất</div>
                <div class="card-body p-0 text-center text-muted">
                    <span>[Bảng điểm sẽ hiển thị ở đây]</span>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold"><i class="fas fa-bell me-2"></i>Thông báo mới</div>
                <div class="card-body text-center text-muted">
                    <span>[Thông báo sẽ hiển thị ở đây]</span>
                </div>
            </div>
        </div>
    </div>
</div> 